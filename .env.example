# ==========================================
# NEXIFY DEVOPS — ENVIRONMENT CONFIGURATION
# ==========================================

# --- Backend Server Configuration ---
PORT=5001
NODE_ENV=development

# --- Security & JWT Authentication ---
JWT_SECRET=nexify_devops_enterprise_super_jwt_secret_key_2026

# --- AES-256-GCM Cryptographic Secrets Vault Key (Must be 32 bytes or string) ---
NEXIFY_VAULT_KEY=nexify_enterprise_vault_master_key_2026_32bytes!

# --- Frontend API & Real-Time Socket Connection ---
# For Local Development:
VITE_API_BASE_URL=http://localhost:5001/api/v1
VITE_SOCKET_URL=http://localhost:5001

# For Production (Replace with your live Render backend URL):
# VITE_API_BASE_URL=https://nexify-devops-api.onrender.com/api/v1
# VITE_SOCKET_URL=https://nexify-devops-api.onrender.com
